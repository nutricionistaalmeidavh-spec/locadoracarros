    "admin-navigation": "flows/locadora/admin-navigation.json",
    "rental-inspection": "flows/locadora/rental-inspection.json",
    "backup-restore": "flows/locadora/backup-restore.json",
    "fleet-permissions": "flows/locadora/fleet-permissions.json",
    "sync-screen": "flows/locadora/sync-screen.json"
  }
}