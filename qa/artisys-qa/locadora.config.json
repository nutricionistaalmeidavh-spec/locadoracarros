{
  "schemaVersion": 1,
  "systemId": "locadora-carros",
  "mode": "electron",
  "defaultEnvironment": "local",
  "defaultFlow": "smoke",
  "defaultViewport": "desktop",
  "capture": {
    "video": true,
    "screenshotEachStep": true,
    "fps": 4
  },
  "electron": {
    "entry": "../../electron/main.cjs",
    "env": {
      "LOCADORA_E2E_USER_DATA": "./qa-artifacts/electron-profile",
      "ELECTRON_ENABLE_LOGGING": "1"
    },
    "args": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage"
    ]
  },
  "environments": {
    "local": {}
  },
  "flows": {
    "smoke": "flows/locadora/smoke.json",
    "admin-navigation": "flows/locadora/admin-navigation.json",
    "rental-inspection": "flows/locadora/rental-inspection.json",
    "backup-restore": "flows/locadora/backup-restore.json",
    "fleet-permissions": "flows/locadora/fleet-permissions.json",
    "sync-screen": "flows/locadora/sync-screen.json"
  }
}
